# Copy this file to .env for local development and replace placeholders.
# Never commit .env or real credentials to GitHub.

APP_ENV=development

# Telegram bot token from BotFather
BOT_TOKEN=replace_with_telegram_bot_token

# Telegram numeric user ID of the first superadmin
SUPERADMIN_ID=8686341550

# Telegram group where card top-up requests are reviewed
ADMIN_GROUP_ID=-1003747381544

# Telegram group where daily employee reports are posted
REPORT_GROUP_ID=-1001234567891

# HTTPS address of the employee Mini App (set after deploying or creating an HTTPS tunnel)
WEB_APP_URL=

# Separate local development database; configure production separately on the server.
DATABASE_URL=postgresql+asyncpg://postgres:replace_me@localhost:5432/hisobot_bot_dev

# Generate a unique random value for each environment before running the application.
SECRET_KEY=replace_with_a_random_secret_of_at_least_32_characters

# Local Docker Compose database password; use a separate managed secret in production.
POSTGRES_PASSWORD=replace_with_local_database_password
